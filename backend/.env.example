# Copy to backend/.env. DATABASE_URL and one model setup are required.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/redline

# Use a long random value anywhere that isn't your own laptop.
JWT_SECRET=change-me-in-production

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic instead:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium

# A local model on llama-server instead:
# LLM_PROVIDER=llamacpp
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# LLAMACPP_MODEL=name-for-the-sidebar
# LLAMACPP_MAX_TOKENS=4096

PINECONE_API_KEY=
PINECONE_INDEX=redline-chunks

# Optional. Web research uses DuckDuckGo without it.
TAVILY_API_KEY=

# Only needed if soffice isn't on the PATH or in its usual folder.
# SOFFICE_PATH=
